#!/bin/sh
# Show a PDF in a pdfpane next to the calling tmux pane, at the spot of a source line.
#   pdfpane-sync file.pdf [line file.tex]
# With a pdfpane already showing the PDF, it just turns the page; otherwise it splits
# the window and starts one, keeping the focus where it was. Used as vimtex's viewer.

pdf=$(realpath "$1")
page=1 y=
if [ -n "$2" ] && [ -n "$3" ]; then
  # The line's page and height on it (points from the top)
  where=$(synctex view -i "$2:1:$3" -o "$pdf" 2>/dev/null)
  page=$(printf '%s\n' "$where" | sed -n '/^Page:/{s///p;q}')
  y=$(printf '%s\n' "$where" | sed -n '/^y:/{s///p;q}')
fi

# The path `pdfpane --fifo` prints, without starting Python
fifo=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/pdfpane-$(printf '%s' "$pdf" | sha1sum | cut -c1-12).fifo
# A viewer holds the FIFO open; the timeout covers a FIFO left behind by a crash
if [ -p "$fifo" ] && timeout 1 sh -c 'echo "page $1 $2" > "$3"' sh "${page:-1}" "$y" "$fifo"; then
  exit 0
fi
[ -p "$fifo" ] && rm -f "$fifo"

# PDFPANE_FROM: the pane to focus after a double-click jump back to the source
tmux split-window -h -d -l 45% ${TMUX_PANE:+-t "$TMUX_PANE" -e "PDFPANE_FROM=$TMUX_PANE"} \
  "exec pdfpane $(printf '%s' "$pdf" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/") ${page:-1} $y"
