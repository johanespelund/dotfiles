#!/usr/bin/python3
"""Show a PDF in a terminal pane as Sixel graphics, reloading when the file changes.

Needs a Sixel terminal (WezTerm, foot, Windows Terminal 1.22+), inside tmux 3.4+ built
with Sixel. Renders with Poppler (python3-gi, python3-gi-cairo) and a small Sixel encoder
in C, compiled with gcc on first use.

    pdfpane file.pdf [page]

Keys: j/k or space/backspace next/previous page, g/G first/last, w fit width/page,
J/K scroll (fit width), i invert colours, r redraw, q quit. Mouse: wheel turns pages
(scrolls in fit width); double-click jumps to that spot in the LaTeX source in Neovim
(SyncTeX + vimtex's VimtexInverseSearch), then focuses the pane in $PDFPANE_FROM.
Other programs can turn the page through the control FIFO (see fifo_path), e.g.
    echo "page 4" > "$(pdfpane --fifo file.pdf)"
which is how Neovim's \\lv (pdfpane-sync) jumps to the cursor's page.
"""

import ctypes
import fcntl
import hashlib
import os
import re
import select
import signal
import struct
import subprocess
import sys
import tempfile
import termios
import threading
import time
import tty

import cairo
import gi

gi.require_version("Poppler", "0.18")
from gi.repository import GLib, Poppler  # noqa: E402

COLOURS = 32  # in the Sixel palette, at most 64
SIXEL_C = r"""
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
typedef struct { char *s; size_t n, cap; } Buf;
static void put(Buf *b, int ch, int n) {
    if (b->n + 16 > b->cap) b->s = realloc(b->s, b->cap = 2 * b->cap + 65536);
    if (n > 3) b->n += sprintf(b->s + b->n, "!%d%c", n, ch);
    else while (n--) b->s[b->n++] = ch;
}
#define PRINT(...) do { char t[128]; sprintf(t, __VA_ARGS__); \
    for (char *c = t; *c; c++) put(&b, *c, 1); } while (0)
#define RGB15(p) ((p)[2] >> 3 << 10 | (p)[1] >> 3 << 5 | (p)[0] >> 3)
/* BGRx pixels (cairo RGB24) as Sixel in up to 64 colours, median cut without dithering.
   Each band of six rows is filled with its commonest colour and the others drawn over it. */
char *sixel(const unsigned char *px, int w, int h, int stride, int colours, int invert,
            size_t *len) {
    int cnt[32768] = {0}, box[32768], list[32768], tmp[32768], start[65] = {0};
    int ncol = 0, nb = 1, flip = invert ? 32767 : 0;
    unsigned char *idx = malloc((size_t)w * h), *line = malloc((size_t)w * colours);
    unsigned long long *left = malloc(w * sizeof *left);
    Buf b = {0};
    for (int y = 0; y < h; y++)
        for (int x = 0; x < w; x++) {
            int c = RGB15(px + (size_t)y * stride + 4 * x) ^ flip;
            if (!cnt[c]++) list[ncol++] = c;
        }
    start[1] = ncol;
    /* Split the box with the widest channel range where it holds half its pixels */
    for (; nb < colours; nb++) {
        int best = -1, range = 0, axis = 0, pos[33] = {0};
        for (int k = 0; k < nb; k++)
            for (int a = 0; a <= 10; a += 5) {
                int lo = 31, hi = 0;
                for (int j = start[k]; j < start[k + 1]; j++) {
                    int v = list[j] >> a & 31;
                    lo = v < lo ? v : lo, hi = v > hi ? v : hi;
                }
                if (hi - lo > range) best = k, range = hi - lo, axis = a;
            }
        if (best < 0) break;
        int s = start[best], e = start[best + 1], m = s;
        long total = 0, half = 0;
        for (int j = s; j < e; j++) pos[(list[j] >> axis & 31) + 1]++, total += cnt[list[j]];
        for (int v = 1; v < 33; v++) pos[v] += pos[v - 1];
        for (int j = s; j < e; j++) tmp[pos[list[j] >> axis & 31]++] = list[j];
        memcpy(list + s, tmp, (e - s) * sizeof *list);
        while (m < e - 2 && 2 * (half += cnt[list[m]]) < total) m++;
        memmove(start + best + 2, start + best + 1, (nb - best) * sizeof *start);
        start[best + 1] = m + 1;
    }
    PRINT("\033P0;0;0q\"1;1;%d;%d", w, h);
    for (int k = 0; k < nb; k++) {
        long n = 0, s[3] = {0};
        for (int j = start[k]; j < start[k + 1]; j++) {
            int c = list[j];
            n += cnt[c], box[c] = k;
            for (int a = 0; a < 3; a++) s[a] += cnt[c] * (c >> (10 - 5 * a) & 31);
        }
        for (int a = 0; a < 3; a++) s[a] = s[a] * 100 / 31 / n;
        PRINT("#%d;2;%ld;%ld;%ld", k, s[0], s[1], s[2]);
    }
    for (int y = 0; y < h; y++)
        for (int x = 0; x < w; x++)
            idx[(size_t)y * w + x] = box[RGB15(px + (size_t)y * stride + 4 * x) ^ flip];
    for (int y = 0; y < h; y += 6) {
        int rows = h - y < 6 ? h - y : 6, n[64] = {0}, top = 0, end = w;
        memset(line, 0, (size_t)w * nb);
        memset(left, 0, w * sizeof *left);
        for (int r = 0; r < rows; r++)
            for (int x = 0; x < w; x++) {
                int k = idx[(size_t)(y + r) * w + x];
                n[k]++, line[k * w + x] |= 1 << r, left[x] |= 1ull << k;
            }
        for (int k = 1; k < nb; k++) if (n[k] > n[top]) top = k;
        PRINT("#%d", top);
        put(&b, 63 + (1 << rows) - 1, w);
        /* The other colours in passes across the band, switching colour as needed */
        for (int x = 0; x < w; x++) left[x] &= ~(1ull << top);
        for (int k = top;;) {
            while (end && !left[end - 1]) end--;
            if (!end) break;
            int ch = '$', run = 1;
            for (int x = 0; x < end; x++) {
                int c = '?';
                if (left[x]) {
                    if (!(left[x] >> k & 1)) {
                        put(&b, ch, run), run = 0;
                        PRINT("#%d", k = __builtin_ctzll(left[x]));
                    }
                    c = 63 + line[k * w + x], left[x] &= ~(1ull << k);
                }
                if (c != ch) put(&b, ch, run), ch = c, run = 0;
                run++;
            }
            put(&b, ch, run);
        }
        if (y + 6 < h) put(&b, '-', 1);
    }
    PRINT("\033\\");
    free(idx), free(line), free(left);
    *len = b.n;
    return b.s;
}
"""


def log(*args):
    """Debug trace, when PDFPANE_LOG names a file."""
    if os.environ.get("PDFPANE_LOG"):
        with open(os.environ["PDFPANE_LOG"], "a") as f:
            print(f"{time.monotonic():.3f}", *args, file=f)


def fifo_path(pdf):
    run = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    key = hashlib.sha1(os.path.realpath(pdf).encode()).hexdigest()[:12]
    return os.path.join(run, f"pdfpane-{key}.fifo")


def pane_size():
    """(cols, rows, cell width px, cell height px) of this pane."""
    rows, cols, xpx, ypx = struct.unpack("HHHH", fcntl.ioctl(1, termios.TIOCGWINSZ, b"\0" * 8))
    if xpx and ypx:
        return cols, rows, xpx / cols, ypx / rows
    return cols, rows, 10, 20  # terminal didn't say; a common cell size


def sixel_encoder():
    """The C encoder as a function of (surface, first row, rows, invert), compiled once."""
    src = SIXEL_C.encode()
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    lib = os.path.join(cache, "pdfpane", f"sixel-{hashlib.sha1(src).hexdigest()[:12]}.so")
    if not os.path.exists(lib):
        os.makedirs(os.path.dirname(lib), exist_ok=True)
        tmp = f"{lib}.{os.getpid()}"
        subprocess.run(["gcc", "-O2", "-shared", "-fPIC", "-x", "c", "-", "-o", tmp],
                       input=src, check=True)
        os.replace(tmp, lib)
    c = ctypes.CDLL(lib)
    c.sixel.restype = ctypes.c_void_p
    c.sixel.argtypes = [ctypes.c_void_p] + [ctypes.c_int] * 5 + [ctypes.POINTER(ctypes.c_size_t)]
    free = ctypes.CDLL(None).free
    free.argtypes = [ctypes.c_void_p]

    def encode(surface, top, rows, invert):
        stride = surface.get_stride()
        pixels = ctypes.addressof(ctypes.c_char.from_buffer(surface.get_data())) + top * stride
        size = ctypes.c_size_t()
        out = c.sixel(pixels, surface.get_width(), rows, stride, COLOURS, invert,
                      ctypes.byref(size))
        data = ctypes.string_at(out, size.value)
        free(out)
        return data
    return encode


class Viewer:
    def __init__(self, pdf, page):
        self.pdf = pdf
        self.page = page
        self.fit_width = False
        self.scroll = 0  # pixel offset from the top in fit-width mode
        self.invert = False
        self.doc = None
        self.pages = 0
        self.sizes = []
        self.mtime = self.tried = None  # of the PDF shown, and last looked at
        self.dirty = False  # redraw once the pending input is handled
        self.encode = sixel_encoder()
        # Rendered pages and Sixel by layout; a worker prepares what is likely next
        self.pixels = {}
        self.sixels = {}
        self.pending = {}
        self.wanted = []
        self.worker = None
        self.lock = threading.Lock()
        self.render_lock = threading.Lock()  # one Poppler render at a time
        self.message = ""
        self.geometry = None  # where the page was drawn, for mapping clicks
        self.last_click = (0.0, None)

    def layout(self, page, scroll=0):
        """(key, pad, cell w and h, page width, shown and full height in px, page points).
        The key (page, width, scroll, height, invert, mtime) names the Sixel."""
        cols, rows, cw, ch = pane_size()
        width_px = int(cols * cw)
        height_px = int((rows - 1) * ch)  # the bottom line is the status bar
        pw, ph = self.sizes[page - 1]
        w = max(1, width_px if self.fit_width else int(min(width_px, height_px * pw / ph)))
        full_h = max(1, int(w * ph / pw))
        # A pixel too tall spills onto the status line and tmux drops the whole image
        h = min(full_h, height_px)
        scroll = max(0, min(scroll, full_h - h))
        pad = max(0, int((width_px - w) / cw / 2))
        return (page, w, scroll, h, self.invert, self.mtime), pad, cw, ch, w, h, full_h, pw, ph

    def sixel(self, key):
        """The Sixel for a layout key: cached, from the worker, or made now."""
        with self.lock:
            if key in self.sixels:
                self.sixels[key] = self.sixels.pop(key)  # most recently used last
                return self.sixels[key]
            done = self.pending.get(key)
            mine = done is None
            if mine:
                done = self.pending[key] = threading.Event()
        if not mine:
            done.wait()
            with self.lock:
                return self.sixels.get(key, b"")
        page, w, scroll, h, invert, mtime = key
        try:
            with self.render_lock:
                if mtime != self.mtime:
                    return b""  # the PDF was reloaded meanwhile
                surface = self.pixels.get((page, w, mtime))
                if surface is None:
                    surface = self.pixels[(page, w, mtime)] = self.render_page(page, w)
                    while len(self.pixels) > 6:
                        self.pixels.pop(next(iter(self.pixels)))
            data = self.encode(surface, scroll, h, invert)
            with self.lock:
                self.sixels[key] = data
                while len(self.sixels) > 12:
                    self.sixels.pop(next(iter(self.sixels)))
            return data
        finally:
            with self.lock:
                self.pending.pop(key)
            done.set()

    def render_page(self, page, width):
        p = self.doc.get_page(page - 1)
        pw, ph = p.get_size()
        surface = cairo.ImageSurface(cairo.FORMAT_RGB24, width, max(1, int(width * ph / pw)))
        ctx = cairo.Context(surface)
        ctx.set_source_rgb(1, 1, 1)
        ctx.paint()
        ctx.scale(width / pw, width / pw)
        p.render(ctx)
        surface.flush()
        return surface

    def prefetch(self, keys):
        """Prepare these in the background, in order, replacing earlier wishes."""
        with self.lock:
            self.wanted = keys
            if not self.worker:
                self.worker = threading.Thread(target=self.work, daemon=True)
                self.worker.start()

    def work(self):
        while True:
            with self.lock:
                todo = [k for k in self.wanted if k not in self.sixels and k not in self.pending]
                if not todo:
                    self.worker = None
                    return
                self.wanted.remove(todo[0])
            self.sixel(todo[0])

    def render(self):
        """Draw the current page below a one-line status bar."""
        self.dirty = False
        key, pad, cw, ch, w, h, full_h, pw, ph = self.layout(self.page, self.scroll)
        self.scroll = key[2]
        sixel = self.sixel(key)
        out = sys.stdout.buffer
        # Synchronized output (mode 2026): the terminal shows the frame once complete
        out.write(b"\x1b[?2026h")
        # Clearing first shows a black pane while the image is processed; a page of the
        # same size and place covers the old one, so then just draw over it
        if self.geometry is None or (self.geometry[0], self.geometry[3:5]) != (pad, (w, h)):
            out.write(b"\x1b[H\x1b[2J")
        self.geometry = (pad, cw, ch, w, h, full_h, pw, ph)
        # Centre the page horizontally
        out.write(f"\x1b[1;{pad + 1}H".encode())
        out.write(sixel)
        self.status()
        out.write(b"\x1b[?2026l")
        out.flush()
        # Likely next: the neighbouring pages, or the next scroll steps in fit width
        nearby = [(self.page + d, 0) for d in (1, -1, 2, -2) if 1 <= self.page + d <= self.pages]
        if self.fit_width:
            step = self.step()
            nearby[:0] = [(self.page, self.scroll + step), (self.page, self.scroll - step)]
        self.prefetch([self.layout(p, s)[0] for p, s in nearby])

    def status(self, message=None):
        if message is not None:
            self.message = message
        cols, rows, _, _ = pane_size()
        mode = "width" if self.fit_width else "page"
        text = f" {os.path.basename(self.pdf)}  {self.page}/{self.pages}  [{mode}]  {self.message}"
        sys.stdout.write(f"\x1b[{rows};1H\x1b[2K\x1b[7m{text[:cols].ljust(cols)}\x1b[0m")
        sys.stdout.flush()

    def reload_if_changed(self, force=False):
        try:
            mtime = os.stat(self.pdf).st_mtime
        except FileNotFoundError:
            return
        # Wait for latexmk to finish writing: the file must have stopped changing
        if (mtime == self.tried and not force) or time.time() - mtime < 0.2:
            return
        self.tried = mtime
        # From memory, so that rewriting the file cannot affect pages still to render
        with open(self.pdf, "rb") as f, self.render_lock:
            try:
                doc = Poppler.Document.new_from_bytes(GLib.Bytes(f.read()), None)
            except GLib.Error:
                return  # damaged: still being written, try again
            sizes = [doc.get_page(i).get_size() for i in range(doc.get_n_pages())]
            if not sizes:
                return
            self.doc, self.sizes, self.mtime, self.pages = doc, sizes, mtime, len(sizes)
        self.page = max(1, min(self.page, self.pages))
        self.render()

    def step(self):
        """Scroll step for J/K: most of a screen."""
        _, rows, _, ch = pane_size()
        return int((rows - 1) * ch * 0.8)

    def goto(self, page):
        page = max(1, min(page, self.pages))
        if page != self.page:
            self.page, self.scroll = page, 0
            self.dirty = True

    def key(self, k):
        if k in ("j", " ", "n", "\x1b[B", "\x1b[6~"):
            self.goto(self.page + 1)
        elif k in ("k", "\x7f", "p", "\x1b[A", "\x1b[5~"):
            self.goto(self.page - 1)
        elif k == "g":
            self.goto(1)
        elif k == "G":
            self.goto(self.pages)
        elif k == "w":
            self.fit_width, self.scroll = not self.fit_width, 0
            self.dirty = True
        elif k in ("J", "K") and self.fit_width:
            self.scroll += self.step() if k == "J" else -self.step()
            self.dirty = True
        elif k == "i":
            self.invert = not self.invert
            self.dirty = True
        elif k == "r":
            self.reload_if_changed(force=True)
        elif k == "q":
            return False
        return True

    def mouse(self, button, col, row, press):
        """SGR mouse report: 1-based cell, button 0 = left, 64/65 = wheel up/down."""
        log("mouse", button, col, row, press)
        if not press:
            return
        if button in (64, 65):
            down = button == 65
            if self.fit_width:
                self.key("J" if down else "K")
            else:
                self.goto(self.page + (1 if down else -1))
            return
        if button != 0:
            return
        now = time.monotonic()
        last_time, last_cell = self.last_click
        self.last_click = (now, (col, row))
        # tmux reports the second click of a double-click one cell off, so allow that
        if (last_cell and abs(last_cell[0] - col) <= 1 and abs(last_cell[1] - row) <= 1
                and now - last_time < 0.5):
            self.last_click = (0.0, None)
            self.inverse_search(*last_cell)

    def inverse_search(self, col, row):
        if not self.geometry:
            return
        pad, cw, ch, w, h, full_h, pw, ph = self.geometry
        # Centre of the clicked cell, in page pixels, then in PDF points from the top left
        x = (col - 1 - pad) * cw + cw / 2
        y = (row - 1) * ch + ch / 2 + self.scroll
        log("click at page px", x, y, "geometry", self.geometry)
        if not (0 <= x <= w and 0 <= y <= full_h):
            return
        x, y = x / w * pw, y / full_h * ph
        out = subprocess.run(["synctex", "edit", "-o", f"{self.page}:{x:.1f}:{y:.1f}:{self.pdf}"],
                             capture_output=True, text=True).stdout
        log("synctex", out.strip().replace("\n", " | ")[:300])
        src = re.search(r"^Input:(.*)$", out, re.M)
        line = re.search(r"^Line:(\d+)", out, re.M)
        if not (src and line):
            self.status("no source found here (compiled with SyncTeX?)")
            return
        path = os.path.normpath(src.group(1))
        # Same command zathura runs: every Neovim that has this project open jumps
        subprocess.Popen(["nvim", "--headless", "-c",
                          f"VimtexInverseSearch {line.group(1)}:0 '{path}'"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        if os.environ.get("PDFPANE_FROM"):
            # Delayed: tmux's own double-click handling selects this pane right after
            subprocess.Popen(["tmux", "run-shell", "-d", "0.3",
                              f"tmux select-pane -t {os.environ['PDFPANE_FROM']}"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.status(f"-> {os.path.basename(path)}:{line.group(1)}")

    def command(self, line):
        parts = line.split()
        if len(parts) == 2 and parts[0] == "page" and parts[1].isdigit():
            self.goto(int(parts[1]))


def main():
    if len(sys.argv) >= 3 and sys.argv[1] == "--fifo":
        print(fifo_path(sys.argv[2]))
        return
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    pdf = os.path.abspath(sys.argv[1])
    viewer = Viewer(pdf, int(sys.argv[2]) if len(sys.argv) > 2 else 1)

    fifo = fifo_path(pdf)
    if os.path.exists(fifo):
        os.remove(fifo)
    os.mkfifo(fifo, 0o600)
    # Opened read-write so it never reports EOF when a writer closes
    ctl = os.open(fifo, os.O_RDWR | os.O_NONBLOCK)

    old = termios.tcgetattr(0)
    resized = []
    signal.signal(signal.SIGWINCH, lambda *_: resized.append(1))
    # Closing the pane: clean up as for q, or the next pdfpane-sync waits for the stale FIFO
    signal.signal(signal.SIGHUP, lambda *_: sys.exit())
    signal.signal(signal.SIGTERM, lambda *_: sys.exit())
    try:
        tty.setcbreak(0)
        # Hide the cursor; report mouse clicks and wheel (SGR encoding, 1-based cells)
        sys.stdout.write("\x1b[?25l\x1b[?1000h\x1b[?1006h")
        while not viewer.doc:
            viewer.reload_if_changed(force=True)
            if not viewer.doc:
                viewer.status("waiting for the PDF")
                time.sleep(0.2)
        buf = b""
        running = True
        while running:
            try:
                ready, _, _ = select.select([0, ctl], [], [], 0.1)
            except InterruptedError:
                ready = []
            if resized:
                resized.clear()
                viewer.render()
            if 0 in ready:
                data = os.read(0, 1024).decode(errors="ignore")
                # Arrow and page keys arrive as escape sequences; others one by one
                for k in re.findall(r"\x1b\[<\d+;\d+;\d+[Mm]|\x1b\[[0-9;]*[A-Za-z~]|.", data, re.S):
                    m = re.match(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])", k)
                    if m:
                        b, c, r = map(int, m.groups()[:3])
                        viewer.mouse(b, c, r, m.group(4) == "M")
                        continue
                    if not viewer.key(k):
                        running = False
                        break
            if ctl in ready:
                buf += os.read(ctl, 1024)
                *lines, buf = buf.split(b"\n")
                for line in lines:
                    viewer.command(line.decode(errors="ignore"))
            if viewer.dirty:
                viewer.render()
            viewer.reload_if_changed()
    finally:
        os.close(ctl)
        if os.path.exists(fifo):
            os.remove(fifo)
        termios.tcsetattr(0, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[?1006l\x1b[?1000l\x1b[H\x1b[2J\x1b[?25h")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
