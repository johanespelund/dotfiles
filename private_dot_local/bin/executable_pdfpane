#!/usr/bin/env python3
"""Show a PDF in a terminal pane as Sixel graphics, reloading when the file changes.

Needs a Sixel terminal (WezTerm, foot, Windows Terminal 1.22+), inside tmux 3.4+ built
with Sixel. Renders with pdftoppm and ImageMagick's convert.

    pdfpane file.pdf [page]

Keys: j/k or space/backspace next/previous page, g/G first/last, w fit width/page,
J/K scroll (fit width), i invert colours, r redraw, q quit. Mouse: wheel turns pages
(scrolls in fit width); double-click jumps to that spot in the LaTeX source in Neovim
(SyncTeX + vimtex's VimtexInverseSearch), then focuses the pane in $PDFPANE_FROM.
Other programs can turn the page through the control FIFO (see fifo_path), e.g.
    echo "page 4" > "$(pdfpane --fifo file.pdf)"
which is how Neovim's \\lv (pdfpane-sync) jumps to the cursor's page.
"""

import fcntl
import hashlib
import os
import re
import select
import signal
import struct
import subprocess
import sys
import tempfile
import termios
import threading
import time
import tty


def log(*args):
    """Debug trace, when PDFPANE_LOG names a file."""
    if os.environ.get("PDFPANE_LOG"):
        with open(os.environ["PDFPANE_LOG"], "a") as f:
            print(f"{time.monotonic():.3f}", *args, file=f)


def fifo_path(pdf):
    run = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    key = hashlib.sha1(os.path.realpath(pdf).encode()).hexdigest()[:12]
    return os.path.join(run, f"pdfpane-{key}.fifo")


def pane_size():
    """(cols, rows, cell width px, cell height px) of this pane."""
    rows, cols, xpx, ypx = struct.unpack("HHHH", fcntl.ioctl(1, termios.TIOCGWINSZ, b"\0" * 8))
    if xpx and ypx:
        return cols, rows, xpx / cols, ypx / rows
    return cols, rows, 10, 20  # terminal didn't say; a common cell size


def page_sizes(pdf):
    """{page: (width, height) in points}, from one pdfinfo call; {} if unreadable."""
    out = subprocess.run(["pdfinfo", pdf], capture_output=True, text=True).stdout
    m = re.search(r"^Pages:\s+(\d+)", out, re.M)
    if not m:
        return {}
    out = subprocess.run(["pdfinfo", "-f", "1", "-l", m.group(1), pdf],
                         capture_output=True, text=True).stdout
    return {int(n): (float(w), float(h))
            for n, w, h in re.findall(r"^Page\s+(\d+) size:\s+([\d.]+) x ([\d.]+)", out, re.M)}


def encode(pdf, page, scale_w, scale_h, crop, invert):
    """The page as Sixel. Uncompressed PPM and 32 colours without dithering: about
    five times faster than PNG and 256 dithered colours, and looks the same for text."""
    ppm = subprocess.run(
        ["pdftoppm", "-f", str(page), "-l", str(page),
         "-scale-to-x", str(scale_w), "-scale-to-y", str(scale_h), pdf],  # no root: stdout
        capture_output=True).stdout
    if not ppm:
        return b""
    args = ["convert", "ppm:-"]
    if crop:
        args += ["-crop", crop, "+repage"]
    if invert:
        args += ["-negate"]
    args += ["+dither", "-colors", "32", "sixel:-"]
    return subprocess.run(args, input=ppm, capture_output=True).stdout


class Viewer:
    def __init__(self, pdf, page):
        self.pdf = pdf
        self.page = page
        self.fit_width = False
        self.scroll = 0  # pixel offset from the top in fit-width mode
        self.invert = False
        self.pages = 0
        self.sizes = {}
        self.mtime = None
        self.dirty = False  # redraw once the pending input is handled
        # Sixel by layout; neighbouring pages are prepared in the background
        self.cache = {}
        self.pending = {}
        self.lock = threading.Lock()
        self.message = ""
        self.geometry = None  # where the page was drawn, for mapping clicks
        self.last_click = (0.0, None)

    def layout(self, page):
        """(key, page width, height and crop in pixels, pad, cell size, page points)."""
        cols, rows, cw, ch = pane_size()
        width_px = int(cols * cw)
        height_px = int((rows - 1) * ch)  # the bottom line is the status bar
        pw, ph = self.sizes.get(page, (595.0, 842.0))
        if self.fit_width:
            scale_w = width_px
        else:
            scale_w = int(min(width_px, height_px * pw / ph))
        scale_h = int(scale_w * ph / pw)
        crop = None
        if self.fit_width:
            scroll = max(0, min(self.scroll, scale_h - height_px)) if page == self.page else 0
            crop = f"{scale_w}x{min(height_px, scale_h)}+0+{scroll}"
        else:
            # pdftoppm rounds up; a pixel too tall spills onto the status line and
            # tmux drops the whole image
            scale_h = min(scale_h, height_px)
        pad = max(0, int((width_px - scale_w) / cw / 2))
        key = (page, scale_w, scale_h, crop, self.invert, self.mtime)
        return key, scale_w, scale_h, crop, pad, cw, ch, pw, ph

    def sixel(self, page):
        key, scale_w, scale_h, crop, *_ = self.layout(page)
        with self.lock:
            if key in self.cache:
                return self.cache[key]
            waiting = self.pending.get(key)
        if waiting:
            waiting.wait()
            with self.lock:
                if key in self.cache:
                    return self.cache[key]
        data = encode(self.pdf, page, scale_w, scale_h, crop, self.invert)
        with self.lock:
            if data:
                self.cache[key] = data
                while len(self.cache) > 12:
                    self.cache.pop(next(iter(self.cache)))
        return data

    def prefetch(self, page):
        if not 1 <= page <= self.pages:
            return
        key, scale_w, scale_h, crop, *_ = self.layout(page)
        with self.lock:
            if key in self.cache or key in self.pending:
                return
            done = self.pending[key] = threading.Event()
        invert = self.invert

        def work():
            data = encode(self.pdf, page, scale_w, scale_h, crop, invert)
            with self.lock:
                if data:
                    self.cache[key] = data
                self.pending.pop(key, None)
            done.set()

        threading.Thread(target=work, daemon=True).start()

    def render(self):
        """Draw the current page below a one-line status bar."""
        self.dirty = False
        if self.fit_width:
            _, _, scale_h, _, _, _, ch, _, _ = self.layout(self.page)
            _, rows, _, _ = pane_size()
            self.scroll = max(0, min(self.scroll, scale_h - int((rows - 1) * ch)))
        key, scale_w, scale_h, crop, pad, cw, ch, pw, ph = self.layout(self.page)
        sixel = self.sixel(self.page)
        if not sixel:
            self.status("could not render page (PDF being written?)")
            return
        out = sys.stdout.buffer
        # Synchronized output (mode 2026): the terminal shows the frame once complete
        out.write(b"\x1b[?2026h")
        # Clearing first shows a black pane while the image is processed; a page of the
        # same size and place covers the old one, so then just draw over it
        same_place = self.geometry is not None and (
            self.geometry[0], self.geometry[3], self.geometry[4]) == (pad, scale_w, scale_h)
        if not same_place:
            out.write(b"\x1b[H\x1b[2J")
        # Centre the page horizontally
        self.geometry = (pad, cw, ch, scale_w, scale_h, pw, ph)
        out.write(f"\x1b[1;{pad + 1}H".encode())
        out.write(sixel)
        self.status()
        out.write(b"\x1b[?2026l")
        out.flush()
        if not self.fit_width:
            self.prefetch(self.page + 1)
            self.prefetch(self.page - 1)

    def status(self, message=None):
        if message is not None:
            self.message = message
        cols, rows, _, _ = pane_size()
        mode = "width" if self.fit_width else "page"
        text = f" {os.path.basename(self.pdf)}  {self.page}/{self.pages}  [{mode}]  {self.message}"
        sys.stdout.write(f"\x1b[{rows};1H\x1b[2K\x1b[7m{text[:cols].ljust(cols)}\x1b[0m")
        sys.stdout.flush()

    def reload_if_changed(self, force=False):
        try:
            mtime = os.stat(self.pdf).st_mtime
        except FileNotFoundError:
            return
        if not force and mtime == self.mtime:
            return
        # Wait for latexmk to finish writing: the file must stop changing
        time.sleep(0.2)
        if os.stat(self.pdf).st_mtime != mtime:
            return
        sizes = page_sizes(self.pdf)
        if not sizes:
            return
        self.mtime, self.sizes, self.pages = mtime, sizes, len(sizes)
        self.page = max(1, min(self.page, self.pages))
        self.render()

    def goto(self, page):
        page = max(1, min(page, self.pages))
        if page != self.page:
            self.page, self.scroll = page, 0
            self.dirty = True

    def key(self, k):
        _, rows, _, ch = pane_size()
        step = int((rows - 1) * ch * 0.8)
        if k in ("j", " ", "n", "\x1b[B", "\x1b[6~"):
            self.goto(self.page + 1)
        elif k in ("k", "\x7f", "p", "\x1b[A", "\x1b[5~"):
            self.goto(self.page - 1)
        elif k == "g":
            self.goto(1)
        elif k == "G":
            self.goto(self.pages)
        elif k == "w":
            self.fit_width, self.scroll = not self.fit_width, 0
            self.dirty = True
        elif k == "J" and self.fit_width:
            self.scroll += step
            self.dirty = True
        elif k == "K" and self.fit_width:
            self.scroll -= step
            self.dirty = True
        elif k == "i":
            self.invert = not self.invert
            self.dirty = True
        elif k == "r":
            self.reload_if_changed(force=True)
        elif k == "q":
            return False
        return True

    def mouse(self, button, col, row, press):
        """SGR mouse report: 1-based cell, button 0 = left, 64/65 = wheel up/down."""
        log("mouse", button, col, row, press)
        if not press:
            return
        if button in (64, 65):
            down = button == 65
            if self.fit_width:
                self.key("J" if down else "K")
            else:
                self.goto(self.page + (1 if down else -1))
            return
        if button != 0:
            return
        now = time.monotonic()
        last_time, last_cell = self.last_click
        self.last_click = (now, (col, row))
        # tmux reports the second click of a double-click one cell off, so allow that
        if (last_cell and abs(last_cell[0] - col) <= 1 and abs(last_cell[1] - row) <= 1
                and now - last_time < 0.5):
            self.last_click = (0.0, None)
            self.inverse_search(*last_cell)

    def inverse_search(self, col, row):
        if not self.geometry:
            return
        pad, cw, ch, scale_w, scale_h, pw, ph = self.geometry
        # Centre of the clicked cell, in page pixels, then in PDF points from the top left
        x = (col - 1 - pad) * cw + cw / 2
        y = (row - 1) * ch + ch / 2 + (self.scroll if self.fit_width else 0)
        log("click at page px", x, y, "geometry", self.geometry)
        if not (0 <= x <= scale_w and 0 <= y <= scale_h):
            return
        x, y = x / scale_w * pw, y / scale_h * ph
        out = subprocess.run(["synctex", "edit", "-o", f"{self.page}:{x:.1f}:{y:.1f}:{self.pdf}"],
                             capture_output=True, text=True).stdout
        log("synctex", out.strip().replace("\n", " | ")[:300])
        src = re.search(r"^Input:(.*)$", out, re.M)
        line = re.search(r"^Line:(\d+)", out, re.M)
        if not (src and line):
            self.status("no source found here (compiled with SyncTeX?)")
            return
        path = os.path.normpath(src.group(1))
        # Same command zathura runs: every Neovim that has this project open jumps
        subprocess.Popen(["nvim", "--headless", "-c",
                          f"VimtexInverseSearch {line.group(1)}:0 '{path}'"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        if os.environ.get("PDFPANE_FROM"):
            # Delayed: tmux's own double-click handling selects this pane right after
            subprocess.Popen(["tmux", "run-shell", "-d", "0.3",
                              f"tmux select-pane -t {os.environ['PDFPANE_FROM']}"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.status(f"-> {os.path.basename(path)}:{line.group(1)}")

    def command(self, line):
        parts = line.split()
        if len(parts) == 2 and parts[0] == "page" and parts[1].isdigit():
            self.goto(int(parts[1]))


def main():
    if len(sys.argv) >= 3 and sys.argv[1] == "--fifo":
        print(fifo_path(sys.argv[2]))
        return
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    pdf = os.path.abspath(sys.argv[1])
    viewer = Viewer(pdf, int(sys.argv[2]) if len(sys.argv) > 2 else 1)

    fifo = fifo_path(pdf)
    if os.path.exists(fifo):
        os.remove(fifo)
    os.mkfifo(fifo, 0o600)
    # Opened read-write so it never reports EOF when a writer closes
    ctl = os.open(fifo, os.O_RDWR | os.O_NONBLOCK)

    old = termios.tcgetattr(0)
    resized = []
    signal.signal(signal.SIGWINCH, lambda *_: resized.append(1))
    try:
        tty.setcbreak(0)
        # Hide the cursor; report mouse clicks and wheel (SGR encoding, 1-based cells)
        sys.stdout.write("\x1b[?25l\x1b[?1000h\x1b[?1006h")
        while not os.path.exists(pdf):
            viewer.status("waiting for the PDF")
            time.sleep(0.5)
        viewer.reload_if_changed(force=True)
        buf = b""
        running = True
        while running:
            try:
                ready, _, _ = select.select([0, ctl], [], [], 0.5)
            except InterruptedError:
                ready = []
            if resized:
                resized.clear()
                viewer.render()
            if 0 in ready:
                data = os.read(0, 1024).decode(errors="ignore")
                # Arrow and page keys arrive as escape sequences; others one by one
                for k in re.findall(r"\x1b\[<\d+;\d+;\d+[Mm]|\x1b\[[0-9;]*[A-Za-z~]|.", data, re.S):
                    m = re.match(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])", k)
                    if m:
                        b, c, r = map(int, m.groups()[:3])
                        viewer.mouse(b, c, r, m.group(4) == "M")
                        continue
                    if not viewer.key(k):
                        running = False
                        break
            if ctl in ready:
                buf += os.read(ctl, 1024)
                *lines, buf = buf.split(b"\n")
                for line in lines:
                    viewer.command(line.decode(errors="ignore"))
            if viewer.dirty:
                viewer.render()
            viewer.reload_if_changed()
    finally:
        termios.tcsetattr(0, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[?1006l\x1b[?1000l\x1b[H\x1b[2J\x1b[?25h")
        sys.stdout.flush()
        os.close(ctl)
        if os.path.exists(fifo):
            os.remove(fifo)


if __name__ == "__main__":
    main()
